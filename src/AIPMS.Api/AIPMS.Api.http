@AIPMS_Api_HostAddress = http://localhost:5080
@AccessToken = paste-jwt-access-token-here

GET {{AIPMS_Api_HostAddress}}/api/v1/system
Accept: application/json

###

POST {{AIPMS_Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "student@fpt.edu.vn",
  "password": "replace-with-local-password"
}

###

GET {{AIPMS_Api_HostAddress}}/api/v1/auth/me
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

GET {{AIPMS_Api_HostAddress}}/api/v1/projects/lifecycle
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

GET {{AIPMS_Api_HostAddress}}/api/v1/academic/hierarchy?includeInactive=false
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

GET {{AIPMS_Api_HostAddress}}/api/v1/academic/majors?organizationId=1&page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

POST {{AIPMS_Api_HostAddress}}/api/v1/academic/majors
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "departmentId": 1,
  "code": "SE_AI",
  "name": "Software Engineering - AI",
  "description": "Software Engineering program with an AI specialization."
}

###

POST {{AIPMS_Api_HostAddress}}/api/v1/ai/insights/progress
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "totalTasks": 10,
  "overdueTasks": 3,
  "blockedTasks": 2,
  "milestoneCompletionRate": 0.45
}
