{
  "AiAssistant": {
    "Enabled": false,
    "SuiteEnabled": false,
    "MeetingAiEnabled": false,
    "ChatAiEnabled": false,
    "InsightsEnabled": false,
    "DailyQuotaPerUser": 100,
    "RubricGradingCopilotEnabled": false,
    "AppealReviewAssistEnabled": false,
    "ContributionFairnessEnabled": false,
    "LegacyProjectAskEnabled": false,
    "SuggestEvaluationSchemeEnabled": false,
    "DeliverableReviewEnabled": false,
    "ProgressRiskEnabled": false
  },
  "ExecutionConcurrency": {
    "RequireTokens": false,
    "LogMissingTokens": true
  },
  "Security": {
    "RbacMatrixWriteEnabled": false
  },
  "Appeals": {
    "Enabled": false
  },
  "FinalSubmissions": {
    "AllowLegacyOneStepLock": false
  },
  "SupervisorRecommendations": {
    "Enabled": false
  },
  "Chat": {
    "Enabled": false,
    "RealtimeEnabled": false,
    "MaxMessageLength": 4000,
    "EditWindowMinutes": 15,
    "RecallWindowMinutes": 15,
    "OutboxPollSeconds": 5,
    "SendsPerMinute": 30,
    "MaxConnectionsPerUser": 5,
    "InstanceCount": 1
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AI_PMS;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5175"
    ]
  },
  "Jwt": {
    "Issuer": "AI-PMS",
    "Audience": "AI-PMS.Client",
    "SigningKey": "REPLACE_WITH_USER_SECRET_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 60
  },
  "AccountSecurity": {
    "FailedLoginThreshold": 5,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 14,
    "PasswordResetMinutes": 30
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "SenderAddress": "",
    "SenderName": "AI-PMS",
    "Username": "",
    "Password": "",
    "PasswordResetUrl": "http://localhost:5173/reset-password"
  },
  "ScheduledNotifications": {
    "Enabled": true,
    "IntervalSeconds": 300,
    "ReminderHours": 24,
    "BatchSize": 50
  },
  "MeetingReminders": {
    "Enabled": true,
    "MinutesBefore": 15,
    "IntervalSeconds": 30,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "RiskAlert": {
    "Enabled": false,
    "IntervalSeconds": 3600,
    "BatchSize": 50,
    "OverdueTaskThreshold": 3,
    "BlockedTaskThreshold": 2,
    "CriticalRiskScoreThreshold": 50.0
  },
  "DualDeptSla": {
    "Enabled": true,
    "IntervalMinutes": 15
  },
  "NotificationEmail": {
    "Enabled": false,
    "IntervalSeconds": 60,
    "BatchSize": 20,
    "MaxAttempts": 8
  },
  "VideoMeeting": {
    "Enabled": false,
    "Provider": "LIVEKIT",
    "ServerUrl": "",
    "ApiKey": "",
    "ApiSecret": "",
    "JoinTokenTtlSeconds": 300,
    "JoinOpenBeforeMinutes": 0,
    "JoinCloseAfterMinutes": 0
  },
  "Observability": {
    "ApplicationName": "AI-PMS API",
    "LogFilePath": "logs/aipms-.log",
    "RetainedFileCountLimit": 14,
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "LoopbackPermitLimit": 300,
      "AggregatePermitLimit": 10,
      "AggregateLoopbackPermitLimit": 300,
      "WindowMinutes": 1
    }
  }
