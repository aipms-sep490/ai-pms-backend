{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AI_PMS;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "AI-PMS",
    "Audience": "AI-PMS.Client",
    "SigningKey": "REPLACE_WITH_USER_SECRET_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 60
  },
  "Observability": {
    "ApplicationName": "AI-PMS API",
    "LogFilePath": "logs/aipms-.log",
    "RetainedFileCountLimit": 14,
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
